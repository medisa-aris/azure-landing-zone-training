# Salin menjadi lab.env lalu isi nilainya:  cp lab.env.example lab.env
# File lab.env berisi password – JANGAN di-commit (sudah ada di .gitignore).

# ---- Tenant dan subscription ----
TENANT_ID="00000000-0000-0000-0000-000000000000"
TENANT_DOMAIN="pertaminatraining.onmicrosoft.com"
SUB_CONNECTIVITY="00000000-0000-0000-0000-000000000000"   # hub: rg-conn
SUB_MANAGEMENT="00000000-0000-0000-0000-000000000000"     # Log Analytics workspace
SUB_LANDINGZONE="00000000-0000-0000-0000-000000000000"    # spoke tim (di bawah MG Corp)
SUB_ONPREM="00000000-0000-0000-0000-000000000000"         # data center simulasi (MG terpisah, bukan di bawah Landing Zones)

# ---- Management group ----
MG_ROOT="pertamina-training"          # ID MG root training (Reader untuk semua peserta)
MG_LANDINGZONES="pertamina-training-landingzones"

# ---- Region ----
LOCATION_AZURE="indonesiacentral"
LOCATION_ONPREM="southeastasia"

# ---- Tim ----
# Nomor tim 0–9. Tim 0 = "golden team" untuk demo trainer.
TEAMS="0 1 2 3 4 5"

# ---- Log Analytics (dari ALZ, subscription Management) ----
LAW_RESOURCE_ID="/subscriptions/<SUB_MANAGEMENT>/resourceGroups/<rg>/providers/Microsoft.OperationalInsights/workspaces/law-platform-idc"

# ---- Kredensial lab (bagikan lewat kartu tim) ----
ADMIN_USERNAME="labadmin"
ADMIN_PASSWORD="GantiDenganPasswordKuat#2026"        # admin VM + Domain Admin (teamN\labadmin)
SAFEMODE_PASSWORD="GantiDenganPasswordKuat#DSRM26"   # DSRM domain controller
AD_USER_PASSWORD="GantiDenganPasswordUser#2026"      # user OU Sync-Users
PARTICIPANT_PASSWORD="GantiDenganPasswordPeserta#26" # akun userNN di Entra ID

# ---- Notifikasi ----
ALERT_EMAIL="trainer@example.com"
BUDGET_AMOUNT="300"                 # USD per bulan untuk subscription landing zone
BUDGET_START_DATE="2026-11-01"      # harus tanggal 1 bulan berjalan atau setelahnya

# ---- Opsional ----
# URL installer agent Cloud Sync. Kosongkan jika file disalin manual ke C:\LabFiles di setiap DC01.
CLOUDSYNC_AGENT_URL=""
